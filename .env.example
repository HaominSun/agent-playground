# Copy to .env and fill in. .env is gitignored. Do not commit real keys.
# Bash: set -a; source .env; set +a

# Required to call a model. Any non-empty string works for local Ollama.
LLM_API_KEY=

# OpenAI-compatible base URL, including /v1. Omit to use https://api.openai.com/v1.
# DeepSeek:  https://api.deepseek.com/v1
# DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama:    http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Provider model id. Examples: gpt-4o-mini, deepseek-chat, qwen-plus, llama3.2
LLM_MODEL=gpt-4o-mini
